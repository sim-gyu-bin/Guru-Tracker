{
  "name": "guru-tracker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm lint && next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "lint": "tsc --noEmit && biome lint . --max-diagnostics=100",
    "lint:fix": "tsc --noEmit && biome lint . --write --max-diagnostics=100",
    "pret": "biome format .",
    "pret:fix": "biome format . --write",
    "biome": "tsc --noEmit && biome check . --max-diagnostics=100",
    "biome:fix": "tsc --noEmit && biome check . --write --max-diagnostics=100",
    "biome:summary": "biome check --reporter=summary --max-diagnostics=100",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.45.0",
    "next": "16.2.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
