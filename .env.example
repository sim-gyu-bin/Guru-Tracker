# Supabase 프로젝트 Connect 화면에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 키다. 브라우저 코드, 로그, 저장소, 대화에 값을 노출하지 않는다.
SUPABASE_SECRET_KEY=

# SEC Fair Access 식별자: 앱 이름과 실제 운영자 연락 이메일을 넣는다.
SEC_USER_AGENT=

# 내부 동기화 Bearer 인증용 무작위 비밀값(최소 32자). 서버에만 둔다.
SYNC_SECRET=

# 최초 관리자를 지정하는 Google 이메일. 운영자가 서버에만 넣고 저장소·문서·로그에 적지 않는다.
# 값이 없거나 확인된 Google identity와 다르면 아무도 관리자가 되지 않는다.
ADMIN_EMAIL=

# 운영 OAuth 복귀·승인 메일의 HTTPS origin(예: https://example.com). 경로 없이 설정한다.
# 로컬 pnpm dev에서는 비워 두면 localhost·127.0.0.1의 현재 접속 포트를 사용한다.
# 명시한 값이 잘못되면 자동 감지하지 않는다. 미설정 시 승인 메일은 생략된다.
APP_URL=

# Resend 실제 전송 API 키. 값이 없으면 알림만 생략되고 가입 요청은 DB에 남는다.
RESEND_API_KEY=
# Resend에서 인증한 발신 주소(예: Guru Tracker <no-reply@example.com>).
RESEND_FROM=
